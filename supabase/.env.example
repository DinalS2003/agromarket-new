# AgroMarket Supabase Backend Environment Variables
# Copy to /supabase/.env for local development with Supabase CLI

# Supabase Project Base
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# SMS Auth Hook Secret
# Secret used by Supabase Auth to sign payload when invoking the send-sms-hook edge function
SEND_SMS_HOOK_SECRET=your-send-sms-hook-secret

# SMS OTP Provider Settings
# OTP_MODE: 'mock' prints verification code to edge function log; 'live' sends via OTP_API_URL
OTP_MODE=mock
OTP_API_URL=https://api.sms-provider.lk/v2/send
OTP_API_KEY=your-sms-api-key-here
OTP_SENDER_ID=AgroMarket

# PayHere Payment Gateway Configuration
# PAYHERE_MODE: 'sandbox' or 'live'
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=1234567
PAYHERE_MERCHANT_SECRET=your-payhere-merchant-secret-here
# Public endpoint where PayHere posts server-to-server transaction notifications
PAYHERE_NOTIFY_URL=https://your-project.functions.supabase.co/payhere-notify

# Firebase Cloud Messaging (FCM HTTP v1)
# Raw JSON string of Google Cloud Service Account with Firebase Cloud Messaging Admin role
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com"}
